---
global:
  scrape_interval: 15s
  evaluation_interval: 15s

storage:
  tsdb:
    retention:
      time: 15d

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - "127.0.0.1:9090"

  - job_name: node
    static_configs:
      - targets:
          - "{{ hostvars['web01']['ansible_host'] }}:9100"
        labels:
          node: web01
          role: web

      - targets:
          - "127.0.0.1:9100"
        labels:
          node: monitoring01
          role: monitoring

