# Terraform working directory
.terraform/

# Terraform state files
.terraform/
*.tfstate
*.tfstate.*

# Terraform plan files
*.tfplan
tfplan

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files — mungkin mengandungi secrets
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Environment and credential files
.env
.env.*
!.env.example
*.pem
*.key

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Ansible Galaxy downloaded roles
ansible/roles/*
!ansible/roles/.gitkeep

# Ansible retry files
*.retry
